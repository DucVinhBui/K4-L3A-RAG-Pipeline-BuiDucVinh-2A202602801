# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: openai | gemini | anthropic
LLM_PROVIDER=openai
LLM_MODEL=

# Generation providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: sentence_transformers | openai | gemini
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3

# Optional services
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Bonus: cross-encoder rerank. Bỏ trống dùng mặc định BAAI/bge-reranker-v2-m3
# (~2.2GB tải lần đầu). Chỉ nạp khi bật reranker="cross_encoder".
RERANKER_MODEL=

# Chấm điểm bằng RAGAS (scripts/evaluate.py). Bỏ trống dùng gpt-4o-mini và
# text-embedding-3-small; cần OPENAI_API_KEY ở trên.
EVALUATOR_MODEL=
EVALUATOR_EMBEDDING=

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=
